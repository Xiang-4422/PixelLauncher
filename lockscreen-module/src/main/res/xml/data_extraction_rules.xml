<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- 锁屏模块不把未来的设备适配和安全开关上传到云备份。 -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <!-- 设备迁移也不复制与旧 SystemUI Fingerprint 绑定的配置。 -->
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
