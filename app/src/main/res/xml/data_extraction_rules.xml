<?xml version="1.0" encoding="utf-8"?>
<!--
  排除本机应用清单缓存与内含手机号的短信静音规则，
  覆盖 Android 12+ 云备份与设备迁移两条通道。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_repository_cache.xml" />
        <exclude domain="device_sharedpref" path="app_repository_cache.xml" />
        <exclude domain="sharedpref" path="sms_mute_settings.xml" />
        <exclude domain="device_sharedpref" path="sms_mute_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_repository_cache.xml" />
        <exclude domain="device_sharedpref" path="app_repository_cache.xml" />
        <exclude domain="sharedpref" path="sms_mute_settings.xml" />
        <exclude domain="device_sharedpref" path="sms_mute_settings.xml" />
    </device-transfer>
</data-extraction-rules>
