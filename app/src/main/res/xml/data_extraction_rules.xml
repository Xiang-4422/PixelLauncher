<?xml version="1.0" encoding="utf-8"?>
<!-- 排除只对本机有效的已安装应用清单缓存，覆盖 Android 12+ 云备份与设备迁移两条通道。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_repository_cache.xml" />
        <exclude domain="device_sharedpref" path="app_repository_cache.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_repository_cache.xml" />
        <exclude domain="device_sharedpref" path="app_repository_cache.xml" />
    </device-transfer>
</data-extraction-rules>
