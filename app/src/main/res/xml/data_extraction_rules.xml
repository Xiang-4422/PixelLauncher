<?xml version="1.0" encoding="utf-8"?>
<!-- 永久排除旧版明文敏感偏好，覆盖 Android 12+ 云备份和设备迁移。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pixel_launcher_ai_prefs.xml" />
        <exclude domain="device_sharedpref" path="pixel_launcher_ai_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pixel_launcher_ai_prefs.xml" />
        <exclude domain="device_sharedpref" path="pixel_launcher_ai_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
