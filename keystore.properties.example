# :app release signing.
#
# Copy this file to `keystore.properties` at the repo root (it is gitignored) and
# fill in your release keystore details. With it present, `:app:assembleRelease`
# produces a signed APK at app/build/outputs/apk/release/app-release.apk.
# Without it, release builds are produced unsigned (debug builds and CI are
# unaffected either way).
#
# Generate a keystore once with:
#   keytool -genkeypair -v -keystore release.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias pixellauncher

storeFile=/absolute/path/to/release.jks
storePassword=CHANGE_ME
keyAlias=pixellauncher
keyPassword=CHANGE_ME
